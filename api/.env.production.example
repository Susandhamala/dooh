# Production settings for ads.rentallnepal.com. Copy to api/.env on the server and fill in every
# value marked <...>. Never commit the filled-in file.

APP_NAME="Rentall Screen Ads"
APP_ENV=production
APP_DEBUG=false
# php artisan key:generate --show
APP_KEY=<base64:...>
APP_URL=https://ads.rentallnepal.com
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

# Container logs go to Docker (docker compose logs api), which rotates them.
LOG_CHANNEL=stderr
LOG_LEVEL=warning
LOG_DEPRECATIONS_CHANNEL=null

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=dooh
DB_USERNAME=dooh
# The same value as DB_PASSWORD in the top-level .env. Long and random: openssl rand -hex 24
DB_PASSWORD=<...>

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis
CACHE_STORE=redis

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_FROM_ADDRESS="ads@rentallnepal.com"
MAIL_FROM_NAME="${APP_NAME}"

# Own secret, never shared with rentallnepal.com. openssl rand -hex 32
JWT_SECRET=<...>
JWT_TTL=15
JWT_REFRESH_TTL=1440

# SSO with rentallnepal.com (identity provider)
RENTALL_BASE_URL=https://rentallnepal.com
RENTALL_SSO_CLIENT_SECRET=<...>

# Manifest signing and the device CA (see docs/DEPLOY.md, "Keys and certificates").
MANIFEST_SIGNING_KEY_PATH=/run/secrets/manifest_signing_key
# Leave empty: Docker reads it from infra/ca/out/manifest.env, which lab-ca.sh init writes.
MANIFEST_SIGNING_PUBKEY=
DEVICE_CA_CERT_PATH=/run/secrets/device_ca.crt
DEVICE_CA_KEY_PATH=/run/secrets/device_ca.key

# Phone sign-in codes. "log" only writes them to the log: connect an SMS gateway before launch.
SMS_DRIVER=log

DOOH_TIMEZONE=Asia/Kathmandu

# Lab shortcuts. Ignored when APP_ENV=production, listed so nobody wonders.
LAB_LOCAL_LOGIN=false
OTP_EXPOSE_CODE=false
SIMULATE_PLAYS=false
